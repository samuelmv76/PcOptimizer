<Window x:Class="PcOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PcOptimizer.App.Converters"
        Title="PC Optimizer" Height="720" Width="1080"
        MinHeight="520" MinWidth="880"
        Background="{StaticResource PageBackground}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <conv:SeverityToBrushConverter x:Key="SeverityBrush" />
        <conv:SeverityToLabelConverter x:Key="SeverityLabel" />
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />

        <!-- Simular, Aplicar y el punto de restauracion no tienen sentido
             en un modulo que solo lee: se ocultan en vez de deshabilitarse. -->
        <Style x:Key="RemediationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDiagnostic}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>



        <!-- Modulos que corrigen cosas: tabla con seleccion. -->
        <DataTemplate x:Key="ActionableView">
            <DockPanel>

                <Expander DockPanel.Dock="Bottom" Margin="0,10,0,0"
                          IsExpanded="True"
                          Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisible}}">
                    <Expander.Header>
                        <TextBlock Text="Elementos que no se pudieron aplicar"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBorder}" />
                    </Expander.Header>
                    <Border Background="{StaticResource WarningBackground}"
                            BorderBrush="{StaticResource WarningBorder}" BorderThickness="1"
                            CornerRadius="4" Padding="10,8" Margin="0,6,0,0">
                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Errors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Expander>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Seleccionar todo" Style="{StaticResource LinkButton}"
                            Command="{Binding SelectAllCommand}" />
                    <Button Content="No seleccionar nada" Style="{StaticResource LinkButton}"
                            Command="{Binding SelectNoneCommand}" />
                    <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding Findings}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource Hairline}"
                          BorderBrush="{StaticResource Hairline}"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          SelectionMode="Single"
                          EnableRowVirtualization="True">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding Recommendation}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRecommendation}" Value="False">
                                    <Setter Property="ToolTip" Value="{x:Null}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="36" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="6" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                            Width="4" CornerRadius="2" Margin="0,3" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Elemento" Width="300"
                                            Binding="{Binding Title}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Detalles" Width="*"
                                            Binding="{Binding Details}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Tamano" Width="110"
                                            Binding="{Binding Size}" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
        </DataTemplate>

        <!-- Modulos que solo informan: fichas con el estado y que hacer. -->
        <DataTemplate x:Key="DiagnosticView">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <ItemsControl ItemsSource="{Binding Findings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                    CornerRadius="6" Margin="0,0,0,8" Background="White">
                                <DockPanel>

                                    <Border DockPanel.Dock="Left" Width="4"
                                            Background="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                            CornerRadius="6,0,0,6" />

                                    <StackPanel Margin="14,12">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding Size}"
                                                       Style="{StaticResource Muted}"
                                                       Margin="12,0,0,0" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                        </DockPanel>

                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}"
                                                   Margin="0,3,0,0" />

                                        <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="4"
                                                Background="{StaticResource PanelBackground}"
                                                Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVisible}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityLabel}}"
                                                           FontWeight="SemiBold" FontSize="11"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                                <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navegacion -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="PC Optimizer"
                           Foreground="White" FontSize="16" FontWeight="SemiBold"
                           Margin="18,18,18,14" />

                <ListBox DockPanel.Dock="Top"
                         ItemsSource="{Binding Modules}"
                         SelectedItem="{Binding SelectedModule}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource SidebarForeground}" />
                            <Setter Property="Padding" Value="18,10" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Shell" Background="Transparent"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Shell" Property="Background"
                                                        Value="{StaticResource SidebarSelected}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Shell" Property="Background"
                                                        Value="{StaticResource SidebarSelected}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock VerticalAlignment="Bottom" Margin="18,12"
                           Foreground="#78808F" FontSize="11" TextWrapping="Wrap"
                           Text="Todo cambio queda registrado en %LOCALAPPDATA%\PcOptimizer\audit.log" />
            </DockPanel>
        </Border>

        <!-- Pagina -->
        <DockPanel Grid.Column="1" Margin="0">

            <Border DockPanel.Dock="Top" Padding="24,20,24,16"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedModule.DisplayName}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding SelectedModule.Description}" Style="{StaticResource Muted}"
                               Margin="0,4,0,0" MaxWidth="740" HorizontalAlignment="Left" />

                    <Border Margin="0,12,0,0" Padding="12,9" CornerRadius="4"
                            Background="{StaticResource WarningBackground}"
                            BorderBrush="{StaticResource WarningBorder}" BorderThickness="1"
                            Visibility="{Binding NeedsElevationWarning, Converter={StaticResource BoolToVisible}}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Este apartado necesita permisos de administrador para verlo todo. Sin ellos, parte de los elementos no aparecera y aplicar cambios fallara." />
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Analizar" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ScanCommand}" />
                        <Button Content="Simular" Command="{Binding SimulateCommand}"
                                Style="{StaticResource RemediationButton}" />
                        <Button Content="Aplicar" Command="{Binding ApplyCommand}"
                                Style="{StaticResource RemediationButton}" />
                        <Button Content="Cancelar" Command="{Binding CancelCommand}" />

                        <CheckBox Content="Crear punto de restauracion antes de aplicar"
                                  IsChecked="{Binding CreateRestorePoint}"
                                  VerticalAlignment="Center" Margin="10,0,0,0"
                                  Visibility="{Binding ShowRestorePointOption, Converter={StaticResource BoolToVisible}}" />

                        <CheckBox Content="Borrar al reiniciar los ficheros en uso"
                                  IsChecked="{Binding DeleteLockedOnReboot}"
                                  VerticalAlignment="Center" Margin="10,0,0,0"
                                  ToolTip="Un fichero que otro programa tiene abierto no se puede borrar ahora. Con esta opcion se le pide a Windows que lo borre en el proximo arranque."
                                  Visibility="{Binding ShowRebootDeletionOption, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="24,10"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Right" Width="120" Height="4"
                                 IsIndeterminate="True" Margin="16,0,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ContentControl Content="{Binding}" Margin="24,16,24,16">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource ActionableView}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDiagnostic}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource DiagnosticView}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

        </DockPanel>
    </Grid>
</Window>
