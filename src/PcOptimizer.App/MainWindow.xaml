<Window x:Class="PcOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PcOptimizer.App.Converters"
        Title="PC Optimizer"
        Height="780" Width="1200"
        MinHeight="580" MinWidth="920"
        Icon="/Assets/AppIcon.ico"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource TextFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <conv:SeverityToBrushConverter x:Key="SeverityBrush" />
        <conv:SeverityToLabelConverter x:Key="SeverityLabel" />
        <conv:ModuleGlyphConverter x:Key="ModuleGlyph" />
        <conv:NullToVisibilityConverter x:Key="NullToVisible" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisible" />
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />

        <!-- ================================================ Barra lateral -->

        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" CornerRadius="8" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SidebarItemHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SidebarItemSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" />
                            <Border x:Name="Overlay" Background="{DynamicResource SidebarItemHover}"
                                    CornerRadius="8" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SidebarItemSelected}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ================================================ Fichas del resumen -->

        <!-- Ficha pulsable: toda la tarjeta lleva a su apartado. -->
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource CardRadius}" />
                            <Border x:Name="Overlay" Background="{DynamicResource HoverOverlay}"
                                    CornerRadius="{StaticResource CardRadius}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource PressedOverlay}" />
                                <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================ Vista: Resumen -->

        <DataTemplate x:Key="SummaryView">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="36,0,36,28">

                    <!-- El equipo -->
                    <Button Style="{StaticResource Tile}"
                            Visibility="{Binding HasMachineCard, Converter={StaticResource BoolToVisible}}"
                            Command="{Binding GoToModuleCommand}"
                            CommandParameter="{Binding MachineCard}">
                        <Grid Margin="22,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="56" Height="56" CornerRadius="14"
                                    Background="{DynamicResource AccentSubtle}" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="26"
                                           Foreground="{DynamicResource Accent}"
                                           Text="{Binding MachineCard.RelatedModuleId, Converter={StaticResource ModuleGlyph}}" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="18,2,12,0">
                                <TextBlock Text="{Binding MachineCard.Title}" Style="{StaticResource Title2}" />
                                <TextBlock Text="{Binding MachineCard.Details}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding MachineCard.Recommendation}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                           Visibility="{Binding MachineCard.HasRecommendation, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Style="{StaticResource Glyph}" Text="&#xE76C;"
                                       FontSize="12" Foreground="{DynamicResource TextTertiary}" />
                        </Grid>
                    </Button>

                    <TextBlock Text="Apartados" Style="{StaticResource SectionHeader}" Margin="4,26,0,12" />

                    <ItemsControl ItemsSource="{Binding SectionCards}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Tile}"
                                        Width="266" Height="176" Margin="0,0,14,14"
                                        Command="{Binding DataContext.GoToModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Grid Margin="18,16,18,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <DockPanel>
                                            <Border Width="36" Height="36" CornerRadius="10"
                                                    Background="{DynamicResource AccentSubtle}">
                                                <TextBlock Style="{StaticResource Glyph}" FontSize="17"
                                                           Foreground="{DynamicResource Accent}"
                                                           Text="{Binding RelatedModuleId, Converter={StaticResource ModuleGlyph}}" />
                                            </Border>

                                            <!-- Cuanto hay pendiente, o una marca si no hay nada -->
                                            <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PendingCount}"
                                                           FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="26" FontWeight="SemiBold"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                                           Visibility="{Binding IsClear, Converter={StaticResource InverseBoolToVisible}}" />
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="20"
                                                           Foreground="{DynamicResource Success}"
                                                           Visibility="{Binding IsClear, Converter={StaticResource BoolToVisible}}" />
                                            </Grid>
                                        </DockPanel>

                                        <TextBlock Grid.Row="1" Text="{Binding Title}" Style="{StaticResource Headline}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,14,0,0" />

                                        <TextBlock Grid.Row="2" Text="{Binding Details}" Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,3,0,0" />

                                        <TextBlock Grid.Row="3" Text="{Binding Recommendation}" Style="{StaticResource Caption}"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,8,0,0"
                                                   VerticalAlignment="Top" MaxHeight="34" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- ================================================ Vista: diagnostico -->

        <!-- Lista agrupada en una tarjeta, con separadores entre filas. -->
        <DataTemplate x:Key="DiagnosticView">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource Card}" Margin="36,0,36,28" VerticalAlignment="Top"
                        Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisible}}">
                    <ItemsControl ItemsSource="{Binding Findings}" AlternationCount="100000" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Border x:Name="Divider" Height="1" VerticalAlignment="Top"
                                            Background="{DynamicResource Separator}" Margin="46,0,0,0" />

                                    <Grid Margin="20,15,20,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Width="9" Height="9" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                 Margin="0,5,0,0"
                                                 Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Headline}" />
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />

                                            <Border x:Name="Advice" Margin="0,10,0,0" Padding="12,9" CornerRadius="8"
                                                    Background="{DynamicResource AppBackground}"
                                                    Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVisible}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityLabel}}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                                    <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Body}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Top" Margin="16,1,0,0" />
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="0">
                                        <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                        <Setter TargetName="Advice" Property="Background" Value="{DynamicResource WarningBackground}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </ScrollViewer>
        </DataTemplate>

        <!-- ================================================ Vista: accionable -->

        <DataTemplate x:Key="ActionableView">
            <Grid Margin="36,0,36,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="2,4">
                    <DataGrid ItemsSource="{Binding Findings}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Recommendation}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecommendation}" Value="False">
                                        <Setter Property="ToolTip" Value="{x:Null}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="50" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="36" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Left"
                                                 Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Elemento" Width="2*" IsReadOnly="True"
                                                Binding="{Binding Title}" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Detalles" Width="3*" IsReadOnly="True"
                                                Binding="{Binding Details}" ElementStyle="{StaticResource CellTextSecondary}" />
                            <DataGridTextColumn Header="Tamaño" Width="104" IsReadOnly="True"
                                                Binding="{Binding Size}" ElementStyle="{StaticResource CellTextSecondary}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Seleccionar todo" Style="{StaticResource LinkButton}"
                            Command="{Binding SelectAllCommand}" />
                    <Button Content="Ninguno" Style="{StaticResource LinkButton}"
                            Command="{Binding SelectNoneCommand}" />
                    <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <Border Grid.Row="2" Margin="0,12,0,0" Padding="16,12" CornerRadius="12"
                        Background="{DynamicResource WarningBackground}"
                        BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1"
                        Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisible}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" FontSize="14"
                                       Foreground="{DynamicResource WarningText}" />
                            <TextBlock Text="No se pudo aplicar a todo" Style="{StaticResource Headline}"
                                       Foreground="{DynamicResource WarningText}" Margin="8,0,0,0" />
                        </StackPanel>
                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <ItemsControl ItemsSource="{Binding Errors}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,3,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ================================================ Vista: Ajustes -->

        <DataTemplate x:Key="SettingsView">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="36,0,36,28" MaxWidth="760" HorizontalAlignment="Left"
                            DataContext="{Binding Settings}">

                    <TextBlock Text="Apariencia" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Card}">
                        <Grid Margin="20,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Tema" Style="{StaticResource Headline}" />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0"
                                           Text="Sistema sigue al tema de Windows y cambia cuando cambia él." />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource SegmentBackground}"
                                    CornerRadius="8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="Theme"
                                                 Content="Oscuro" IsChecked="{Binding IsDarkTheme}" />
                                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="Theme"
                                                 Content="Claro" IsChecked="{Binding IsLightTheme}" />
                                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="Theme"
                                                 Content="Sistema" IsChecked="{Binding IsSystemTheme}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Text="Análisis" Style="{StaticResource SectionHeader}" Margin="4,28,0,8" />
                    <Border Style="{StaticResource Card}">
                        <Grid Margin="20,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Analizar el equipo al abrir" Style="{StaticResource Headline}" />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0"
                                           Text="Revisa todos los apartados en segundo plano nada más arrancar. Solo lee: no cambia nada." />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" IsChecked="{Binding AnalyzeOnStartup}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Datos" Style="{StaticResource SectionHeader}" Margin="4,28,0,8" />
                    <Border Style="{StaticResource Card}">
                        <Grid Margin="20,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Carpeta de datos" Style="{StaticResource Headline}" />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0"
                                           Text="Ajustes, registro de auditoría y diario de cambios para deshacer." />
                                <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextTertiary}" Margin="0,6,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Abrir" VerticalAlignment="Center"
                                    Command="{Binding OpenDataFolderCommand}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Acerca de" Style="{StaticResource SectionHeader}" Margin="4,28,0,8" />
                    <Border Style="{StaticResource Card}">
                        <Grid Margin="20,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Source="/Assets/AppIcon.png" Width="64" Height="64"
                                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Margin="18,4,0,0">
                                <TextBlock Text="PC Optimizer" Style="{StaticResource Title2}" />
                                <TextBlock Text="{Binding Version, StringFormat=Versión {0}}"
                                           Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                           Text="Software libre con licencia GPL-3.0. Solo toca lo que tú eliges, y todo lo que cambia queda anotado para poder deshacerlo." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================================================== Barra lateral -->
        <Border Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,20,18">
                    <Image Source="/Assets/AppIcon.png" Width="30" Height="30"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="PC Optimizer" FontFamily="{StaticResource DisplayFont}"
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,16">
                    <Button Style="{StaticResource SidebarButton}" Margin="10,0"
                            Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="15" Width="20"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="Ajustes" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ListBox ItemsSource="{Binding Modules}"
                         SelectedItem="{Binding SidebarSelection}"
                         IsEnabled="{Binding CanNavigate}"
                         ItemContainerStyle="{StaticResource SidebarItem}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="15" Width="20"
                                           Foreground="{DynamicResource Accent}"
                                           Text="{Binding Id, Converter={StaticResource ModuleGlyph}}" />
                                <TextBlock Text="{Binding DisplayName}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ==================================================== Pagina -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="36,30,36,0">
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource LargeTitle}" />
                <TextBlock Text="{Binding PageDescription}" Style="{StaticResource Secondary}"
                           Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left" />

                <Border Margin="0,14,0,0" Padding="12,8" CornerRadius="8" HorizontalAlignment="Left"
                        Background="{DynamicResource WarningBackground}"
                        BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1"
                        Visibility="{Binding NeedsElevationWarning, Converter={StaticResource BoolToVisible}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" FontSize="13"
                                   Foreground="{DynamicResource WarningText}" />
                        <TextBlock Margin="8,0,0,0" MaxWidth="680" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Sin permisos de administrador parte de este apartado no se ve, y aplicar cambios fallará." />
                    </StackPanel>
                </Border>

                <!-- Acciones -->
                <DockPanel Margin="0,20,0,0" LastChildFill="False"
                           Visibility="{Binding ShowScan, Converter={StaticResource BoolToVisible}}">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Analizar" />
                            </StackPanel>
                        </Button>
                        <Button Content="Simular" Command="{Binding SimulateCommand}" Margin="0,0,8,0"
                                Visibility="{Binding ShowRemediation, Converter={StaticResource BoolToVisible}}" />
                        <Button Content="{Binding ApplyVerb}" Command="{Binding ApplyCommand}" Margin="0,0,8,0"
                                Visibility="{Binding ShowRemediation, Converter={StaticResource BoolToVisible}}" />
                        <Button Content="Cancelar" Command="{Binding CancelCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding ShowRemediation, Converter={StaticResource BoolToVisible}}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,0,20,0"
                                  Content="Punto de restauración"
                                  ToolTip="Crear un punto de restauración de Windows antes de aplicar."
                                  IsChecked="{Binding CreateRestorePoint}"
                                  Visibility="{Binding ShowRestorePointOption, Converter={StaticResource BoolToVisible}}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                  Content="Borrar al reiniciar lo que esté en uso"
                                  ToolTip="Un fichero abierto por otro programa no se puede borrar ahora. Con esta opción se le pide a Windows que lo borre en el próximo arranque."
                                  IsChecked="{Binding DeleteLockedOnReboot}"
                                  Visibility="{Binding ShowRebootDeletionOption, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <ContentControl Grid.Row="1" Content="{Binding}" Margin="0,22,0,0" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource ActionableView}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PageKind}" Value="Summary">
                                <Setter Property="ContentTemplate" Value="{StaticResource SummaryView}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PageKind}" Value="Diagnostic">
                                <Setter Property="ContentTemplate" Value="{StaticResource DiagnosticView}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PageKind}" Value="Settings">
                                <Setter Property="ContentTemplate" Value="{StaticResource SettingsView}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <!-- Barra de estado -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0"
                    Padding="36,11">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,10,0"
                          VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="SpinnerAngle" />
                        </Grid.RenderTransform>
                        <Ellipse Stroke="{DynamicResource Separator}" StrokeThickness="2" />
                        <Path Data="M 7,1 A 6,6 0 0 1 13,7" Stroke="{DynamicResource Accent}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerAngle"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                    </Grid>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
